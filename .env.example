# ZenApply MCP Server Environment Configuration

# Core
PORT=8080
PUBLIC_BASE_URL=https://mcp.zenapply.app
LOG_LEVEL=info

# Upstream ZenApply Service API
ZENAPPLY_API_BASE=https://api.zenapply.app
ZENAPPLY_SERVICE_EMAIL=
ZENAPPLY_SERVICE_PASSWORD=

# Security & Secrets
CURSOR_HMAC_SECRET=
TOKEN_PEPPER=

# State Persistence
STATE_DB_PATH=./data/mcp.sqlite

# Upstream guardrails & limits
UPSTREAM_TIMEOUT_MS=25000
UPSTREAM_CONCURRENCY=1
MAX_RESPONSE_BYTES=262144

# Allowed Redirect URIs (comma-separated, loopbacks always allowed)
ALLOWED_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback

# Ops / Monitoring (optional)
SENTRY_DSN=
DISCORD_OPS_WEBHOOK_URL=
